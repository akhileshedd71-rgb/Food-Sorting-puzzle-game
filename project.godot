; Garden Table — original food sorting puzzle
config_version=5

[application]
config/name="Garden Table"
config/description="A cozy food sorting puzzle. Match three, make a little room, serve something lovely."
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://assets/icon.svg"
config/version="0.2.0"
boot_splash/bg_color=Color(1, 0.969, 0.922, 1)
boot_splash/show_image=false

[display]
window/size/viewport_width=720
window/size/viewport_height=1600
window/size/window_width_override=450
window/size/window_height_override=1000
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=1

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
textures/vram_compression/import_etc2_astc=true
environment/defaults/default_clear_color=Color(0.29, 0.17, 0.08, 1)

[input_devices]
pointing/emulate_mouse_from_touch=false
pointing/emulate_touch_from_mouse=false

[audio]
driver/enable_input=false

[gui]
theme/default_font_multichannel_signed_distance_field=true
